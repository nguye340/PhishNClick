# MongoDB Connection
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/phishnclick?retryWrites=true&w=majority

# Server Configuration
PORT=5000
NODE_ENV=production

# JWT Secrets (generate with: openssl rand -base64 32)
ACCESS_TOKEN_SECRET=your_access_token_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# Cookie Configuration
COOKIE_DOMAIN=app.catphishlabs.ca  # Leave blank for localhost
COOKIE_SECURE=true                  # Set to false for local development
COOKIE_SAMESITE=Lax                 # Lax for same-origin, None for cross-origin

# CORS Origins (comma-separated)
CORS_ORIGINS=https://app.catphishlabs.ca,http://localhost:3000,http://localhost:3001

# Email Service
MAIL_FROM=noreply@catphishlabs.ca
MAIL_PROVIDER=console  # Options: console, ses, sendgrid

# Frontend URL (for password reset links)
FRONTEND_URL=https://app.catphishlabs.ca

# OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880  # 5MB in bytes
